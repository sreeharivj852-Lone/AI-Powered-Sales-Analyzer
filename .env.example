# =====================================================================
# Sales Analyzer & AI Assistant Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file with secrets to version control.
# =====================================================================

# Google Gemini API Key (Get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sales
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# Optional Defense-in-Depth: Dedicated Read-Only User for AI Chatbot
# (If omitted, the chatbot defaults to DB_USER / DB_PASSWORD)
# CHATBOT_DB_USER=sales_readonly
# CHATBOT_DB_PASSWORD=your_readonly_password
